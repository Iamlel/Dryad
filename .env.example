# Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (from https://elevenlabs.io/)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# AI Backend Provider: "gemini" (default) or "local" (LM Studio)
# AI_PROVIDER=gemini

# Local LM Studio Configuration (default: http://127.0.0.1:1234)
# LM_STUDIO_URL=http://127.0.0.1:1234
# LM_STUDIO_MODEL=google/gemma-4-e4b

# Tiger Data (Postgres) connection string for the plant database
TIGER_DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require

# Caretaker rewards: base58 private key of the wallet that pays them, as
# Phantom exports it. Always Solana devnet (test SOL, no real money). Use a
# new wallet made just for this, never one that holds real SOL.
SOLANA_TREASURY_KEY=your_treasury_private_key_here

# Cloudflare tunnel that puts the website on your domain: the token from
# Networking > Tunnels > Create a tunnel in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Password of the board's arduino user (set in Arduino App Lab), for the
# one-time sudo setup of Bluetooth audio
BOARD_PASSWORD=your_board_password_here
